  "narrative": {
    "northStar": "The Control Room",
    "overview": "Modnex es una sala de control para servidores de Minecraft con mods. Todo lo que el usuario necesita saber (qué está en marcha, qué mods hay, quién puede hacer qué) se lee de un vistazo, sin adornos. La interfaz es plana: la jerarquía sale de tres tonos de oscuro, y el verde se reserva para lo que se puede accionar.",
    "keyCharacteristics": [
      "Plano por defecto: jerarquía por capas tonales, no por sombras.",
      "El verde de acción aparece en pocos sitios por pantalla.",
      "Estados siempre visibles con punto, color y texto.",
      "Voz cercana y de juego, sin renunciar a la claridad.",
      "Radios medios y bordes visibles: firme, no blando."
    ],
    "rules": [
      {
        "name": "The One Action Rule",
        "body": "El verde de acción aparece en una sola acción principal por pantalla. Su rareza es lo que la hace clara.",
        "section": "colors"
      },
      {
        "name": "The Flat-At-Rest Rule",
        "body": "Las superficies no tienen sombra en reposo. Una sombra aparece solo como respuesta a un estado: hover, foco o diálogo.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Usa el verde solo para la acción principal de cada pantalla.",
      "Muestra el estado con punto, color y texto a la vez.",
      "Separa el peligro: los botones destructivos van en rojo y piden confirmación."
    ],
    "donts": [
      "No pongas gradientes ni tarjetas idénticas de métricas decorativas.",
      "No uses sombras en reposo en el panel de trabajo.",
      "No mezcles el cian de estado con el verde de acción en la misma acción."
    ]
  }
}
